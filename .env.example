# ==========================================
# CloudVideo Docker 环境变量配置
# 复制本文件为 .env 并修改密码与存储上限后运行:
#   docker compose up -d --build
# ==========================================

# 登录密码（强烈建议修改为强密码！）
APP_PASSWORD=change-me-strong-password

# 会话与播放直链签名密钥（建议改为任意 32 位以上随机字符串）
JWT_SECRET=change-me-random-secret-key-at-least-32-chars

# 对外访问端口
PORT=3000

# 允许视频占用的最大磁盘上限（GB），50-60GB 小盘建议设为 40~45
STORAGE_LIMIT_GB=45

# 播放完成（达到阈值）后延迟多少小时自动卸载（设为 0 表示看完立即删除）
AUTO_DELETE_DELAY_HOURS=24

# 判定为“已看完”的播放进度阈值（0.9 = 90%）
WATCHED_THRESHOLD=0.9

# BT 上传限速（KB/s），避免上传吃满带宽与流量包（0 表示不限速）
UPLOAD_LIMIT_KBPS=512

# qBittorrent 对外 BT 监听端口（TCP/UDP）
QBIT_PORT=6881

# 可选：你的公网访问地址（如 https://video.example.com），留空则自动根据浏览器访问地址生成外链
PUBLIC_BASE_URL=

# 时区
TZ=Asia/Shanghai
